    <string-array name="changelog_2_1">
        <item>Playlists and favorites backup: export to a file and restore later, even on another device</item>
    </string-array>
    <string-array name="changelog_2_0">
        <item>Tag editing: title, artist, album, year, track and genre written straight into the file</item>
        <item>Change the cover from your gallery or search covers online (iTunes and Deezer)</item>
        <item>Apply one cover to every track of an album at once</item>
    </string-array>
    <string-array name="changelog_1_9">
        <item>Lossless audio support: FLAC, WAV and ALAC, with a built-in FFmpeg decoder</item>
        <item>24-bit hi-res audio kept intact on output</item>
        <item>LOSSLESS badge and track format in the player (e.g. FLAC · 24-bit · 96 kHz)</item>
        <item>Lossless filter in the Library</item>
        <item>Tracks that can\'t be played are skipped with a notice</item>
    </string-array>
    <string-array name="changelog_1_8">
        <item>Light, dark or system theme (Settings → Appearance)</item>
    </string-array>
    <string-array name="changelog_1_7">
        <item>Settings screen (gear on Home and Library)</item>
        <item>Languages: Portuguese, English and Spanish</item>
        <item>Built-in equalizer with presets and bass boost</item>
        <item>This what\'s new screen</item>
    </string-array>
    <string-array name="changelog_1_6">
        <item>Long-press Library items: play, queue, rename and delete playlists</item>
        <item>Delete songs from the device</item>
        <item>WhatsApp, Telegram and Messenger audio hidden</item>
        <item>The Home button always goes back to the home screen</item>
    </string-array>
    <string-array name="changelog_1_5">
        <item>3D reels that spin according to the song position</item>
        <item>Menus open where you pressed</item>
        <item>Favorite from the song menu</item>
        <item>No more three dots: options via long press</item>
    </string-array>
    <string-array name="changelog_1_4">
        <item>Favorites with the heart in the player</item>
        <item>Mini cassette for songs without cover art</item>
        <item>Smoother player transition</item>
    </string-array>
    <string-array name="changelog_1_3">
        <item>Playlists: create, rename, delete and save songs</item>
        <item>Drag to reorder tracks</item>
        <item>Long press to open options</item>
    </string-array>
    <string-array name="changelog_1_2">
        <item>Minimal look</item>
        <item>Player with an upright tape, piano keys and 0–9 ruler</item>
        <item>\"Up next\" queue and repeat</item>
    </string-array>
    <string-array name="changelog_1_1">
        <item>Home and Library inspired by YouTube Music</item>
        <item>Album, artist and playlist pages</item>
    </string-array>
    <string-array name="changelog_1_0">
        <item>First release: cassette tape player</item>
        <item>On-device music with background playback</item>
    </string-array>
</resources>
